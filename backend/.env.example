# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-production

# Redis (Channels + Celery). Set USE_INMEMORY_CHANNELS=1 for dev without Redis (no cross-process WS).
REDIS_URL=redis://127.0.0.1:6379/0
USE_INMEMORY_CHANNELS=0

# JWT lifetimes
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Fernet-compatible key (44 chars) or any string (will be hashed). Used for Telegram bot token encryption.
ENCRYPTION_KEY=

# Optional: seed_test_user defaults (override command-line --email / --password)
# TEST_USER_EMAIL=test@example.com
# TEST_USER_PASSWORD=testpassword123

# Production (config.settings.production)
# ALLOWED_HOSTS=example.com
# MYSQL_DATABASE=aio_downloader
# MYSQL_USER=root
# MYSQL_PASSWORD=secret
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
