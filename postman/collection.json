{
  "info": {
    "name": "AIO Downloader",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "job_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/register/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"password_confirm\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.access) pm.environment.set('access_token', j.access);",
                  "if (j.refresh) pm.environment.set('refresh_token', j.refresh);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/refresh/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/auth/me/"
          }
        }
      ]
    },
    {
      "name": "Downloads",
      "item": [
        {
          "name": "Start download",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/downloads/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://www.youtube.com/watch?v=dQw4w9WgXcQ\",\n  \"format\": \"mp4\",\n  \"quality\": \"720p\"\n}"
            }
          }
        },
        {
          "name": "Analyze URL",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/downloads/analyze/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://www.youtube.com/watch?v=dQw4w9WgXcQ\"\n}"
            }
          }
        },
        {
          "name": "List downloads",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/downloads/"
          }
        },
        {
          "name": "Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/downloads/stats/"
          }
        },
        {
          "name": "Cancel download",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/downloads/{{job_id}}/"
          }
        }
      ]
    },
    {
      "name": "Storage",
      "item": [
        {
          "name": "List files",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/storage/"
          }
        },
        {
          "name": "Storage stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/storage/stats/"
          }
        }
      ]
    },
{
       "name": "Integrations",
       "description": "Telegram: only users with role `owner` may set `bot_token` via PATCH. All users set `chat_id` (receiver). GET includes `bot_configured` (whether the owner saved a token). Test/push use the owner token with the caller's receiver.\n\nGoogle Drive: OAuth2 flow for file mirroring. Connect via /auth/, handle callback, then configure settings.",
       "item": [
         {
           "name": "Get Telegram config",
           "request": {
             "method": "GET",
             "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
             "url": "{{base_url}}/api/integrations/telegram/"
           }
         },
         {
           "name": "Save Telegram config",
           "request": {
             "method": "PATCH",
             "header": [
               { "key": "Authorization", "value": "Bearer {{access_token}}" },
               { "key": "Content-Type", "value": "application/json" }
             ],
             "url": "{{base_url}}/api/integrations/telegram/",
             "body": {
               "mode": "raw",
               "raw": "{\n  \"bot_token\": \"\",\n  \"chat_id\": \"\",\n  \"auto_send\": false,\n  \"enabled\": true\n}"
             }
           }
         },
         {
           "name": "Test Telegram",
           "request": {
             "method": "POST",
             "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
             "url": "{{base_url}}/api/integrations/telegram/test/"
           }
         },
         {
           "name": "Push to Telegram",
           "request": {
             "method": "POST",
             "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
             "url": "{{base_url}}/api/integrations/telegram/push/{{job_id}}/"
           }
         },
         {
           "name": "Get Google Drive config",
           "request": {
             "method": "GET",
             "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
             "url": "{{base_url}}/api/integrations/gdrive/"
           }
         },
         {
           "name": "Save Google Drive config",
           "request": {
             "method": "PATCH",
             "header": [
               { "key": "Authorization", "value": "Bearer {{access_token}}" },
               { "key": "Content-Type", "value": "application/json" }
             ],
             "url": "{{base_url}}/api/integrations/gdrive/",
             "body": {
               "mode": "raw",
               "raw": "{\n  \"enabled\": false,\n  \"auto_upload\": false,\n  \"root_folder_id\": \"\"\n}"
             }
           }
         },
         {
           "name": "Get Google Drive auth URL",
           "request": {
             "method": "GET",
             "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
             "url": "{{base_url}}/api/integrations/gdrive/auth/"
           }
         },
         {
           "name": "Google Drive callback",
           "request": {
             "method": "POST",
             "header": [
               { "key": "Authorization", "value": "Bearer {{access_token}}" },
               { "key": "Content-Type", "value": "application/json" }
             ],
             "url": "{{base_url}}/api/integrations/gdrive/callback/",
             "body": {
               "mode": "raw",
               "raw": "{\n  \"code\": \"authorization_code_from_google\",\n  \"state\": \"optional_state_parameter\"\n}"
             }
           }
         },
         {
           "name": "Test Google Drive connection",
           "request": {
             "method": "POST",
             "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
             "url": "{{base_url}}/api/integrations/gdrive/test/"
           }
      },
      {
        "name": "Grabber",
        "description": "Site grabber for crawling websites and discovering/downloading media files.",
        "item": [
          {
            "name": "Create project",
            "request": {
              "method": "POST",
              "header": [
                { "key": "Authorization", "value": "Bearer {{access_token}}" },
                { "key": "Content-Type", "value": "application/json" }
              ],
              "url": "{{base_url}}/api/grabber/projects/",
              "body": {
                "mode": "raw",
                "raw": "{\n  \"name\": \"My Site Grab\",\n  \"start_url\": \"https://example.com\",\n  \"max_depth\": 2,\n  \"max_pages\": 100,\n  \"max_files\": 500,\n  \"concurrency\": 3,\n  \"crawl_delay\": 1.0,\n  \"respect_robots_txt\": true,\n  \"use_javascript\": false\n}"
              }
            }
          },
          {
            "name": "List projects",
            "request": {
              "method": "GET",
              "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
              "url": "{{base_url}}/api/grabber/projects/"
            }
          },
          {
            "name": "Get project detail",
            "request": {
              "method": "GET",
              "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
              "url": "{{base_url}}/api/grabber/projects/{{grabber_project_id}}/"
            }
          },
          {
            "name": "Update project",
            "request": {
              "method": "PATCH",
              "header": [
                { "key": "Authorization", "value": "Bearer {{access_token}}" },
                { "key": "Content-Type", "value": "application/json" }
              ],
              "url": "{{base_url}}/api/grabber/projects/{{grabber_project_id}}/",
              "body": {
                "mode": "raw",
                "raw": "{\n  \"name\": \"Updated Project Name\"\n}"
              }
            }
          },
          {
            "name": "Delete project",
            "request": {
              "method": "DELETE",
              "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
              "url": "{{base_url}}/api/grabber/projects/{{grabber_project_id}}/"
            }
          },
          {
            "name": "Start crawl",
            "request": {
              "method": "POST",
              "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
              "url": "{{base_url}}/api/grabber/projects/{{grabber_project_id}}/start/"
            }
          },
          {
            "name": "Stop crawl",
            "request": {
              "method": "POST",
              "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
              "url": "{{base_url}}/api/grabber/projects/{{grabber_project_id}}/stop/"
            }
          },
          {
            "name": "Pause crawl",
            "request": {
              "method": "POST",
              "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
              "url": "{{base_url}}/api/grabber/projects/{{grabber_project_id}}/pause/"
            }
          },
          {
            "name": "Resume crawl",
            "request": {
              "method": "POST",
              "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
              "url": "{{base_url}}/api/grabber/projects/{{grabber_project_id}}/resume/"
            }
          },
          {
            "name": "Get project stats",
            "request": {
              "method": "GET",
              "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
              "url": "{{base_url}}/api/grabber/projects/{{grabber_project_id}}/stats/"
            }
          },
          {
            "name": "List discovered files",
            "request": {
              "method": "GET",
              "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
              "url": "{{base_url}}/api/grabber/projects/{{grabber_project_id}}/files/?page_size=50"
            }
          },
          {
            "name": "Queue file download",
            "request": {
              "method": "POST",
              "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
              "url": "{{base_url}}/api/grabber/projects/{{grabber_project_id}}/files/{{grabber_file_id}}/download/"
            }
          },
          {
            "name": "Bulk download files",
            "request": {
              "method": "POST",
              "header": [
                { "key": "Authorization", "value": "Bearer {{access_token}}" },
                { "key": "Content-Type", "value": "application/json" }
              ],
              "url": "{{base_url}}/api/grabber/projects/{{grabber_project_id}}/files/download-bulk/",
              "body": {
                "mode": "raw",
                "raw": "{\n  \"file_ids\": [\"file-uuid-1\", \"file-uuid-2\"]\n}"
              }
            }
          },
          {
            "name": "List filters",
            "request": {
              "method": "GET",
              "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
              "url": "{{base_url}}/api/grabber/projects/{{grabber_project_id}}/filters/"
            }
          },
          {
            "name": "Add filter",
            "request": {
              "method": "POST",
              "header": [
                { "key": "Authorization", "value": "Bearer {{access_token}}" },
                { "key": "Content-Type", "value": "application/json" }
              ],
              "url": "{{base_url}}/api/grabber/projects/{{grabber_project_id}}/filters/",
              "body": {
                "mode": "raw",
                "raw": "{\n  \"filter_type\": \"include\",\n  \"target\": \"file_type\",\n  \"pattern\": \"*.mp4\",\n  \"is_regex\": false\n}"
              }
            }
          },
          {
            "name": "Delete filter",
            "request": {
              "method": "DELETE",
              "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
              "url": "{{base_url}}/api/grabber/projects/{{grabber_project_id}}/filters/{{grabber_filter_id}}/"
            }
          }
        ]
      },
      {
        "name": "Sites",
        "description": "Website authentication credentials for the Grabber.",
        "item": [
          {
            "name": "List sites",
            "request": {
              "method": "GET",
              "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
              "url": "{{base_url}}/api/grabber/sites/"
            }
          },
          {
            "name": "Create site",
            "request": {
              "method": "POST",
              "header": [
                { "key": "Authorization", "value": "Bearer {{access_token}}" },
                { "key": "Content-Type", "value": "application/json" }
              ],
              "url": "{{base_url}}/api/grabber/sites/",
              "body": {
                "mode": "raw",
                "raw": "{\n  \"name\": \"Example Site\",\n  \"site_url\": \"https://example.com\",\n  \"username\": \"user@example.com\",\n  \"login_method\": \"cookie\",\n  \"cookies\": {}\n}"
              }
            }
          },
          {
            "name": "Update site",
            "request": {
              "method": "PATCH",
              "header": [
                { "key": "Authorization", "value": "Bearer {{access_token}}" },
                { "key": "Content-Type", "value": "application/json" }
              ],
              "url": "{{base_url}}/api/grabber/sites/{{site_id}}/",
              "body": {
                "mode": "raw",
                "raw": "{\n  \"name\": \"Updated Site\"\n}"
              }
            }
          },
          {
            "name": "Delete site",
            "request": {
              "method": "DELETE",
              "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
              "url": "{{base_url}}/api/grabber/sites/{{site_id}}/"
            }
          }
        ]
      }
   ]
}
